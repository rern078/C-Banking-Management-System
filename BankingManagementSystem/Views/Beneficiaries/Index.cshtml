@model IEnumerable<BankingManagementSystem.Models.Beneficiary>
@{
    ViewData["Title"] = "Beneficiaries";
    var list = Model.ToList();
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-person-check"></i> Beneficiaries</h1>
        <p class="subtitle">Saved payees for faster transfers</p>
    </div>
    <div class="actions">
        <a class="btn" asp-action="Create"><i class="bi bi-plus-lg"></i> Add beneficiary</a>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2><i class="bi bi-list-ul"></i> Payee list</h2>
        <span class="badge">@list.Count total</span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Nickname</th>
                    <th>Account</th>
                    <th>Bank</th>
                    <th>Phone</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in list)
            {
                <tr>
                    <td>@b.Customer?.FullName</td>
                    <td>@b.Nickname</td>
                    <td><code>@b.AccountNumber</code></td>
                    <td>@b.BankName</td>
                    <td>@(b.Phone ?? "—")</td>
                    <td><span class="badge badge-ok">@b.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
