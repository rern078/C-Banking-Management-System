@model BankingManagementSystem.Models.AccountTypeEntity
@{ ViewData["Title"] = "Add account type"; }

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-tags"></i> Add account type</h1>
        <p class="subtitle">Define savings, current, or deposit products</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="form-shell">
    <div class="panel form-main">
        <form asp-action="Create" method="post">
            <div class="form-section">
                <p class="form-section-title">Product</p>
                <div class="form-grid">
                    <label>Type name<input asp-for="TypeName" placeholder="Saving" /></label>
                    <label>Interest rate %<input asp-for="InterestRate" type="number" step="0.01" /></label>
                    <label class="span-full">Minimum balance<input asp-for="MinimumBalance" type="number" step="0.01" /></label>
                    <label class="span-full">Description<input asp-for="Description" /></label>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn" type="submit"><i class="bi bi-check2"></i> Save type</button>
            </div>
        </form>
    </div>
    <aside class="form-aside">
        <h3>Product rules</h3>
        <p>Account types control minimum balance and interest for new accounts.</p>
        <ul>
            <li>Saving usually has a small minimum</li>
            <li>Current often has 0% interest</li>
            <li>Fixed Deposit needs a higher minimum</li>
        </ul>
    </aside>
</div>
