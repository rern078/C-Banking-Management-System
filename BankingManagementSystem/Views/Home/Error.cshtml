@model BankingManagementSystem.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="panel">
    <h1 class="page-title">Something went wrong</h1>
    <p class="subtitle">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted"><strong>Request ID:</strong> @Model.RequestId</p>
    }
</div>
