@model BankingManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-wrap panel">
    <div class="panel-head" style="margin-bottom:0.85rem;">
        <h2><i class="bi bi-bank2"></i> Staff sign in</h2>
    </div>
    <p class="subtitle">Admin · Manager · Staff</p>
    <form asp-action="Login" method="post" class="form-grid" style="grid-template-columns:1fr;">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <label>Email<input asp-for="Email" autocomplete="username" /><span asp-validation-for="Email" class="field-error"></span></label>
        <label>Password<input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span></label>
        <label class="field-check"><input asp-for="RememberMe" /> Remember me</label>
        <button type="submit" class="btn"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
    </form>
    <p class="muted" style="margin-top:1rem;font-size:.88rem;">
        admin@bank.local / Admin@123<br />
        manager@bank.local / Manager@123<br />
        staff@bank.local / Staff@123
    </p>
</div>
