@{
    ViewData["Title"] = "Access denied";
}

<div class="auth-shell auth-shell-single">
    <main class="auth-main">
        <div class="auth-card auth-card-center">
            <span class="auth-icon-lg"><i class="bi bi-shield-exclamation"></i></span>
            <h1 class="auth-title">Access denied</h1>
            <p class="auth-sub">Your role does not have permission to open this page. Ask an administrator if you need wider access.</p>
            <div class="cta-row auth-cta-row">
                <a class="btn btn-auth" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i> Back to home
                </a>
                <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Sign in as another user
                </a>
            </div>
        </div>
    </main>
</div>
