@model BankingManagementSystem.ViewModels.LoanFormViewModel
@{ ViewData["Title"] = "New loan"; }

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-cash-stack"></i> New loan</h1>
        <p class="subtitle">Create a loan for a customer</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="form-shell">
    <div class="panel form-main">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-section">
                <p class="form-section-title">Customer link</p>
                <div class="form-grid">
                    <label>Customer<select asp-for="CustomerId" asp-items="ViewBag.Customers"><option value="">Select customer</option></select></label>
                    <label>Linked account<select asp-for="AccountId" asp-items="ViewBag.Accounts"><option value="">None</option></select></label>
                </div>
            </div>

            <div class="form-section">
                <p class="form-section-title">Loan terms</p>
                <div class="form-grid cols-3">
                    <label class="span-full">Loan type<input asp-for="LoanType" placeholder="Personal" /></label>
                    <label>Principal<input asp-for="PrincipalAmount" type="number" step="0.01" min="1" placeholder="0.00" /></label>
                    <label>Interest rate %<input asp-for="InterestRate" type="number" step="0.01" /></label>
                    <label>Term (months)<input asp-for="TermMonths" type="number" min="1" /></label>
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn" type="submit"><i class="bi bi-check2"></i> Create loan</button>
            </div>
        </form>
    </div>

    <aside class="form-aside">
        <h3>Lending tips</h3>
        <p>Monthly payment is calculated automatically from principal, rate, and term.</p>
        <ul>
            <li>Link an account when disbursement should post there</li>
            <li>Use clear loan types like Personal or Home</li>
            <li>Review rate before confirming</li>
        </ul>
    </aside>
</div>
