@model BankingManagementSystem.ViewModels.FixedDepositFormViewModel
@{ ViewData["Title"] = "Open fixed deposit"; }

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-safe"></i> Open fixed deposit</h1>
        <p class="subtitle">Lock funds until the maturity date</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" asp-action="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="form-shell">
    <div class="panel form-main">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="form-section">
                <p class="form-section-title">Deposit terms</p>
                <div class="form-grid">
                    <label>Customer<select asp-for="CustomerId" asp-items="ViewBag.Customers"><option value="">Select customer</option></select></label>
                    <label>Source account<select asp-for="AccountId" asp-items="ViewBag.Accounts"><option value="">Select account</option></select></label>
                    <label>Principal<input asp-for="PrincipalAmount" type="number" step="0.01" min="1" placeholder="0.00" /></label>
                    <label>Interest rate %<input asp-for="InterestRate" type="number" step="0.01" /></label>
                    <label class="span-full">Term (months)<input asp-for="TermMonths" type="number" min="1" /></label>
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-outline" asp-action="Index">Cancel</a>
                <button class="btn" type="submit"><i class="bi bi-check2"></i> Open FD</button>
            </div>
        </form>
    </div>
    <aside class="form-aside">
        <h3>How maturity is calculated</h3>
        <p>Maturity amount = principal + (principal × rate × term / 12).</p>
        <ul>
            <li>Certificate number is auto-generated</li>
            <li>Typical terms: 6, 12, 24 months</li>
            <li>Status starts Active</li>
        </ul>
    </aside>
</div>
