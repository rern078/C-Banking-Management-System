@model IEnumerable<BankingManagementSystem.Models.FixedDeposit>
@{
    ViewData["Title"] = "Fixed deposits";
    var list = Model.ToList();
}

<div class="page-head">
    <div>
        <h1 class="page-title"><i class="bi bi-safe"></i> Fixed deposits</h1>
        <p class="subtitle">Term deposits with maturity dates</p>
    </div>
    <div class="actions">
        <a class="btn" asp-action="Create"><i class="bi bi-plus-lg"></i> Open FD</a>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2><i class="bi bi-calendar-check"></i> Certificates</h2>
        <span class="badge">@list.Count total</span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Certificate</th>
                    <th>Customer</th>
                    <th>Account</th>
                    <th>Principal</th>
                    <th>Rate</th>
                    <th>Maturity</th>
                    <th>Maturity amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var f in list)
            {
                <tr>
                    <td><code>@f.CertificateNo</code></td>
                    <td>@f.Customer?.FullName</td>
                    <td><code>@f.Account?.AccountNumber</code></td>
                    <td class="money">@f.PrincipalAmount.ToString("C")</td>
                    <td>@f.InterestRate%</td>
                    <td>@f.MaturityDate.ToLocalTime().ToString("d")</td>
                    <td class="money">@f.MaturityAmount.ToString("C")</td>
                    <td><span class="badge badge-ok">@f.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
